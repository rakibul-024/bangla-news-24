MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/
# BETTER_AUTH_DB_URL and BETTER_Auth_DB_URL are also accepted.
MONGODB_DATABASE=bangla-news-24
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Configure both values for each social sign-in provider you want to enable.
# The BETTER_AUTH_GEOGLE_CLIENT_ID and BETTER_AUTH_GEOGLE_SECRET names
# are also accepted for Google.
GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: required only for email verification and password reset.
RESEND_API_KEY=
RESEND_FROM_EMAIL="onboarding@resend.dev"
# Email verification is disabled by default so test senders do not block sign-up.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
